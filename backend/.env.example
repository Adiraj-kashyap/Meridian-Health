# ─── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── Database (Postgres) ────────────────────────────────────────────────
# Local dev via docker-compose (see docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_appointments?schema=public"
# Render/Railway: paste the connection string they give you for the free
# Postgres instance here instead.

# ─── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ─── LLM (Google Gemini) — pre-visit & post-visit summaries ────────────
# Leave blank to run the app without LLM features: the API still works,
# summaries are simply marked llmStatus=FAILED and the raw text is shown.
# Key from https://aistudio.google.com/apikey (free tier available).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_MAX_RETRIES=2

# ─── Email (SMTP via Nodemailer) ───────────────────────────────────────
# Any SMTP provider works: SendGrid, Mailgun, Gmail (app password), or
# Mailtrap for local testing without sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Healthcare Clinic <no-reply@clinic.local>"
SMTP_SECURE=false

# ─── Google Calendar OAuth 2.0 ──────────────────────────────────────────
# See README.md "Google Calendar setup" for how to obtain these from the
# Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# ─── Booking engine tuning ──────────────────────────────────────────────
SLOT_HOLD_MINUTES=5
APPOINTMENT_REMINDER_HOURS_BEFORE=24
